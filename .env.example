NODE_ENV=development
PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=poetmatrix
DB_PASSWORD=change-me
DB_NAME=poetmatrix

# At least 32 characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
PASSWORD_RESET_TTL_SECONDS=1800

FRONTEND_ORIGIN=http://localhost:3000
SWAGGER_ENABLED=false
TRUST_PROXY=false

# Optional. Both must be set together. The account is created only if the email does not exist.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Optional NestJS Observe credentials. Leave empty to disable telemetry.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
